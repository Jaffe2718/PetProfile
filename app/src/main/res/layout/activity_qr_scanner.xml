<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <io.github.jaffe2718.petprofile.ui.ScanFrameView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="88dp"
        android:background="#88000000"
        android:padding="12dp"
        android:text="@string/action_scan_qr"
        android:textColor="@android:color/white" />

    <ImageButton
        android:id="@+id/pickFromGalleryButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="24dp"
        android:background="@drawable/bg_day_unselected"
        android:contentDescription="@string/pick_from_gallery"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_add_image" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/closeButton"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:contentDescription="@string/action_cancel"
        app:icon="@drawable/ic_close"
        app:iconTint="@color/text_primary" />
</FrameLayout>
