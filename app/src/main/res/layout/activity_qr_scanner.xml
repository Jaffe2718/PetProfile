<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <io.github.jaffe2718.petprofile.ui.ScanFrameView
        android:id="@+id/scanFrameView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Torch and gallery controls. The bottom margin is computed in code so the gap above the row
         (measured from the scan frame) and the gap below it stand in the golden ratio. -->
    <LinearLayout
        android:id="@+id/scannerControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/flashlightButton"
            android:layout_width="83dp"
            android:layout_height="83dp"
            android:layout_marginEnd="36dp"
            android:background="@drawable/bg_scanner_control"
            android:contentDescription="@string/scanner_torch_off"
            android:padding="20dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_flashlight"
            android:tint="@color/surface" />

        <ImageButton
            android:id="@+id/pickFromGalleryButton"
            android:layout_width="83dp"
            android:layout_height="83dp"
            android:background="@drawable/bg_scanner_control"
            android:contentDescription="@string/pick_from_gallery"
            android:padding="20dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_add_image"
            android:tint="@color/surface" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/closeButton"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:contentDescription="@string/action_cancel"
        app:icon="@drawable/ic_close"
        app:iconTint="@color/text_primary" />
</FrameLayout>
