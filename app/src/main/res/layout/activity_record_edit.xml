<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/surface"
            app:navigationIcon="@drawable/ic_close"
            app:navigationIconTint="@color/text_primary"
            app:title="@string/action_add_record" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.PetProfile.TextInputLayout.Required"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/label_title">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/titleEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_record_type"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/typeRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/typeEstablishmentRadio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/record_establishment" />

                <RadioButton
                    android:id="@+id/typeDailyRadio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/record_daily" />

                <RadioButton
                    android:id="@+id/typeTransferRadio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/record_transfer" />

                <RadioButton
                    android:id="@+id/typeArchiveRadio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/record_archive" />
            </RadioGroup>

            <Button
                android:id="@+id/timeButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:backgroundTint="@color/button_soft_bg"
                android:gravity="start|center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/button_soft_text"
                app:icon="@drawable/ic_calendar"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="24dp"
                app:iconTint="@color/button_soft_text" />

            <Button
                android:id="@+id/locationButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:backgroundTint="@color/button_soft_bg"
                android:gravity="start|center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/button_soft_text"
                app:icon="@drawable/ic_location_pin"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="24dp"
                app:iconTint="@color/button_soft_text" />

            <LinearLayout
                android:id="@+id/establishmentExtraLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.PetProfile.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/label_keeper">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/establishmentKeeperEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <RadioGroup
                    android:id="@+id/establishmentSourceRadioGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/establishmentSourceBredRadio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/record_establishment_source_breed" />

                    <RadioButton
                        android:id="@+id/establishmentSourceWildRadio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/record_establishment_source_wild" />

                    <RadioButton
                        android:id="@+id/establishmentSourcePurchaseRadio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/record_establishment_source_purchase" />
                </RadioGroup>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/archiveExtraLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioGroup
                    android:id="@+id/archiveReasonRadioGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/archiveDeathRadio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/record_archive_death" />

                    <RadioButton
                        android:id="@+id/archiveTransferRadio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/record_archive_transfer" />
                </RadioGroup>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/transferExtraLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.PetProfile.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/label_transfer_from_person">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/transferFromPersonEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.PetProfile.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/label_transfer_to_person">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/transferToPersonEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/transferFromPlaceButton"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:backgroundTint="@color/button_soft_bg"
                    android:gravity="start|center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textColor="@color/button_soft_text"
                    app:icon="@drawable/ic_location_pin"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="24dp"
                    app:iconTint="@color/button_soft_text" />

                <Button
                    android:id="@+id/transferToPlaceButton"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:backgroundTint="@color/button_soft_bg"
                    android:gravity="start|center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textColor="@color/button_soft_text"
                    app:icon="@drawable/ic_location_pin"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="24dp"
                    app:iconTint="@color/button_soft_text" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/label_attributes"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recordFieldsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <ImageButton
                android:id="@+id/addFieldButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_add_field"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_add_field" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.PetProfile.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="10dp"
                android:hint="@string/label_notes">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/notesEditText"
                    android:layout_width="match_parent"
                    android:layout_height="232dp"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:scrollbars="vertical" />
            </com.google.android.material.textfield.TextInputLayout>

            <io.github.jaffe2718.petprofile.ui.MarkdownImageStrip
                android:id="@+id/imagesContainer"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_image_strip"
                android:padding="8dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/addImageButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_pick_image"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_add_image" />

                <ImageButton
                    android:id="@+id/manageImagesButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_manage_images"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_trash" />
            </LinearLayout>

            <Button
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/primary"
                android:textColor="@android:color/white"
                android:text="@string/action_save" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
